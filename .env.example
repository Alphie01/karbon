# -----------------------------------------------
# EcoPilot — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://ecopilot_user:changeme@localhost:5432/ecopilot_db"

# For Docker Compose, the host is the service name:
# DATABASE_URL="postgresql://ecopilot_user:changeme@db:5432/ecopilot_db"

# PostgreSQL credentials (used by Docker Compose)
POSTGRES_USER="ecopilot_user"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="ecopilot_db"

# NextAuth
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Production URL example:
# NEXTAUTH_URL="https://app.ecopilot.com"

# Node
NODE_ENV="production"

# App domain (used for subdomain routing in middleware)
APP_DOMAIN="app.ecopilot.com"

# Mail (SMTP + IMAP for CRM mail module)
MAIL_HOST="mail.example.com"
MAIL_USER="info"
MAIL_PASS="your-mail-password"
MAIL_FROM="info@example.com"
# NEXT_PUBLIC_MAIL_HOST is shown in the UI (admin mail settings panel)
NEXT_PUBLIC_MAIL_HOST="mail.example.com"
