.DS_Store
Thumbs.db

# Editor configs
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temp and backup files
*.bak
*.old
*.tmp
tmp/

# Local database files
*.db
*.sqlite
*.sqlite3

